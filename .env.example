# OpenAI API 키 (필수) — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# 모델 설정 (기본값으로 두면 됨)
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_JUDGE_MODEL=gpt-4.1       # 심의·재심의 판단 (정확도 우선)
OPENAI_CHAT_MODEL=gpt-4o-mini    # 대안 문구 생성 (비용 우선)
OPENAI_VISION_MODEL=gpt-4o       # 화면·이미지 분석 (가독성 판독 우선)
OPENAI_STT_MODEL=whisper-1

# Cohere API 키 (Rerank, 선택) — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# 경로
DATA_PATH=data/regulations.jsonl
VECTORSTORE_DIR=vectorstore
DB_PATH=lawbee.db
